# ── ForgeFabrik DevStudio — Umgebungsvariablen ────────────────────────────
#
# Kopiere diese Datei nach `.env` und passe die Werte für deine Umgebung an.
# Niemals `.env` in Git einchecken — nur `.env.example`.
#
# Alle Variablen haben im Code hinterlegte Defaults; nicht gesetzte
# Variablen fallen automatisch auf den angegebenen Standard zurück.

# ── Server ────────────────────────────────────────────────────────────────
DEVSTUDIO_SERVER_HOST=0.0.0.0          # Default: 0.0.0.0
DEVSTUDIO_SERVER_PORT=8080             # Default: 8080

# ── Datenbank (optional; Standard: SQLite in-memory) ────────────────────
# DEVSTUDIO_DATABASE_URL=postgres://user:password@localhost:5432/devstudio
# DEVSTUDIO_DATABASE_URL=sqlite:./devstudio.db
DEVSTUDIO_DATABASE_URL=sqlite::memory:

# ── Queue (optional; Standard: In-Memory-Channel) ────────────────────────
DEVSTUDIO_QUEUE_CAPACITY=1024
# DEVSTUDIO_REDIS_URL=redis://localhost:6379

# ── Sandbox ───────────────────────────────────────────────────────────────
DEVSTUDIO_SANDBOX_MAX=10               # Maximale parallele Sandboxes
DEVSTUDIO_SANDBOX_TIMEOUT_SECS=300    # Execution-Timeout in Sekunden
DEVSTUDIO_SANDBOX_WORK_DIR=/tmp/devstudio/sandboxes
DEVSTUDIO_SANDBOX_USE_DOCKER=false    # true = Docker-Isolation

# ── Sicherheits-Scanner ───────────────────────────────────────────────────
DEVSTUDIO_SEC_BLOCK_CRITICAL=true     # Deployment bei Critical-Findings blockieren
DEVSTUDIO_SEC_BLOCK_HIGH=false        # Deployment bei High-Findings blockieren

# ── Deployment ────────────────────────────────────────────────────────────
DEVSTUDIO_DEPLOY_CONSENSUS=3          # Mindest-Votes für Konsens
# DEVSTUDIO_DEPLOY_STAGING_URL=https://staging.example.com
# DEVSTUDIO_DEPLOY_PRODUCTION_URL=https://example.com

# ── KI-Agenten ────────────────────────────────────────────────────────────
DEVSTUDIO_AGENT_MODEL=claude-opus-4-5
DEVSTUDIO_AGENT_MAX_TOKENS=8192
DEVSTUDIO_AGENT_TEMPERATURE=0.7

# Anthropic API Key (optional; ohne Key laufen Agenten im Mock-Modus)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key (optional; Alternative zu Anthropic)
# OPENAI_API_KEY=sk-...

# ── Auth ──────────────────────────────────────────────────────────────────
# WICHTIG: In Produktion mit einem starken, zufälligen Secret ersetzen!
DEVSTUDIO_JWT_SECRET=change-me-in-production-use-a-strong-random-value
DEVSTUDIO_JWT_EXPIRY_SECS=86400       # 24 Stunden

# ── Logging ───────────────────────────────────────────────────────────────
DEVSTUDIO_LOG_LEVEL=info              # trace, debug, info, warn, error
DEVSTUDIO_LOG_JSON=false             # true = JSON-Logs (für Produktions-Log-Aggregation)
